# WA Campus Analyzer - Environment Configuration Example

# Server Configuration
LISTEN_ADDR=127.0.0.1:8080
DB_PATH=./data/analyzer.db
TZ_NAME=Asia/Jakarta

# Webhook Secret (shared between GOWA and Analyzer for HMAC-SHA256)
GOWA_WEBHOOK_SECRET=gowa_webhook_super_secret_key_change_me
GOWA_BASIC_AUTH_PASSWORD=gowa_admin_password_change_me

# OmniRoute AI Configuration (OpenAI Compatible)
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_API_KEY=sk-omniroute-your-api-key
OMNIROUTE_MODEL=gpt-4o-mini

# Dashboard Security
DASHBOARD_PASSWORD=your_dashboard_password_here
SESSION_SECRET=random_secure_32_character_string_for_sessions

# Background Worker Settings
WORKER_CONCURRENCY=2
CONTEXT_MESSAGES=5
CONTEXT_WINDOW_HOURS=24
RETENTION_DAYS=0
